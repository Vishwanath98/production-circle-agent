HOST=127.0.0.1
PORT=8086
LLM_PROVIDER=fake
CIRCLE_DATA_DIR=.local/data
COOKIE_SECURE=false

# OpenAI-compatible local endpoint example:
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_MODEL=local-model
# OPENAI_API_KEY=local-development

# Circle developer-controlled wallet TESTNET only. Keep real values in .env.local.
# CIRCLE_API_HOST=https://api.circle.com
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# CIRCLE_TESTNET_USDC_TOKEN_ID=
# CIRCLE_TESTNET_DESTINATION_ALLOWLIST=0x...
# CIRCLE_TESTNET_FEE_RESERVE_USDC=1

# LangSmith tracing is optional. Native @tool boundaries emit tool spans.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=production-circle-agent-local
